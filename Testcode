<!DOCTYPE html>
<html>
<head>
    <title>Contact Page</title>
</head>

<body>

<h2>Contact Us</h2>

<form>

    <label>Name:</label>
    <input type="text" name="name">
    <br><br>

    <label>Email:</label>
    <input type="email" name="email">
    <br><br>

    <label>Message:</label>
    <textarea name="message"></textarea>
    <br><br>

    <button type="submit">Send Message</button>

</form>

</body>
</html>
